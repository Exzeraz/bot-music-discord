# Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token

# Spotify API credentials (optional - needed for Spotify links)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Path to yt-dlp. Default: "yt-dlp" (looked up in PATH)
YT_DLP_PATH=./bin/yt-dlp_x86.exe

# Path to ffmpeg. Default: "ffmpeg" (looked up in PATH)
FFMPEG_PATH=./bin/ffmpeg.exe
